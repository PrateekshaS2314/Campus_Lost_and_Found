<%- include('partials/header', { title }) %>
<section class="list-page">
  <div class="section-heading">
    <div><span class="eyebrow">COMMUNITY BOARD</span><h1>Lost items</h1><p>Items reported missing around campus.</p></div>
    <a class="button button-primary" href="/lost-items/new">Report a lost item <span aria-hidden="true">→</span></a>
  </div>
  <form class="search-form" action="/lost-items" method="get">
    <label class="visually-hidden" for="search">Search by item, category or location</label>
    <input id="search" name="q" value="<%= search %>" placeholder="Search item, category or location">
    <button class="button button-dark" type="submit">Search</button>
    <% if (search) { %><a class="text-link" href="/lost-items">Clear</a><% } %>
  </form>
  <% if (items.length === 0) { %>
    <div class="empty-state">
      <span class="empty-icon" aria-hidden="true">⌕</span>
      <h2><%= search ? 'No matching reports' : 'No lost items reported yet' %></h2>
      <p><%= search ? 'Try another search term.' : 'If something has gone missing, add a report to help the community look for it.' %></p>
      <% if (!search) { %><a class="button button-primary" href="/lost-items/new">Report a lost item</a><% } %>
    </div>
  <% } else { %>
    <div class="item-grid">
      <% items.forEach((item) => { %>
        <article class="item-card">
          <div class="card-topline"><span class="pill pill-lost">Lost · <%= item.status %></span><span><%= item.category %></span></div>
          <h2><a href="/lost-items/<%= item._id %>"><%= item.itemName %></a></h2>
          <p><%= item.lastSeenLocation %> · <%= item.dateLost.toLocaleDateString() %></p>
          <span class="card-reporter">Reported by <%= item.reportedBy ? item.reportedBy.fullName : 'Unknown student' %></span>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
<%- include('partials/footer') %>
